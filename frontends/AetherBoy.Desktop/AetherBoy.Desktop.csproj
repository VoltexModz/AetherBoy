<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <AssemblyName>AetherBoy.Desktop</AssemblyName>
    <RootNamespace>AetherBoy.Desktop</RootNamespace>
    <Product>AetherBoy</Product>
    <Title>AetherBoy for Wayland</Title>
    <Description>Native Wayland frontend for AetherBoy.</Description>
    <Authors>AetherBoy contributors</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.16" ExcludeAssets="analyzers" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16" />
  </ItemGroup>

  <Target Name="RemoveUnusedSdlMainGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'SDL3-CS.Generators.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\nanoboy\Core\AetherBoy.Core.csproj" />
    <ProjectReference Include="..\..\nanoboy\Runtime\AetherBoy.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../branding/fonts/*" Link="Assets/Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../branding/exports/aetherboy-mark-256.png" Link="Assets/aetherboy-mark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetherBoy.DesktopTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
