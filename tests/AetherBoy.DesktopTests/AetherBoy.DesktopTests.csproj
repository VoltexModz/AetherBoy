<Project Sdk="MSTest.Sdk/4.3.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>AetherBoy.DesktopTests</AssemblyName>
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\frontends\AetherBoy.Desktop\AetherBoy.Desktop.csproj" />
    <Compile Include="..\Shared\BattleSpaceFixture.cs" Link="BattleSpaceFixture.cs" />
  </ItemGroup>

  <Target Name="RemoveUnusedSdlMainGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'SDL3-CS.Generators.dll'" />
    </ItemGroup>
  </Target>

</Project>
