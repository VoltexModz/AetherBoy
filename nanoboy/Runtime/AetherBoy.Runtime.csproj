<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AetherBoy.Runtime</RootNamespace>
    <AssemblyName>AetherBoy.Runtime</AssemblyName>
    <Description>Thread-owned orchestration and immutable snapshots for AetherBoy.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="MediaToolkit.WebRtc.Native.win-x64" Version="0.24.5.1" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>

  <PropertyGroup>
    <OnlineNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</OnlineNativeRid>
    <OnlineNativeRid Condition="'$(OnlineNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</OnlineNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../third_party/online-native-licenses/*" Link="licenses/online-native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/mgba-cheats/*" Link="licenses/mgba-cheats/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/mgba-ereader/*" Link="licenses/mgba-ereader/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/sharpcompress/*" Link="licenses/sharpcompress/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/discord-rpc/*" Link="licenses/discord-rpc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMediaToolkit_WebRtc_Native_win-x64)/native/win-x64/datachannel.dll" Link="datachannel.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../artifacts/native/$(OnlineNativeRid)/libdatachannel.so" Link="libdatachannel.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../artifacts/native/$(OnlineNativeRid)/libdatachannel.so')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\AetherBoy.Core.csproj" />
    <ProjectReference Include="..\..\third_party\GBADotnet.Core\AetherBoy.Vendored.GBADotnet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\UiText.json" LogicalName="AetherBoy.UiText.json" />
    <EmbeddedResource Include="Netplay\WebRtcBridge.html" LogicalName="AetherBoy.Runtime.Netplay.WebRtcBridge.html" />
    <EmbeddedResource Include="Netplay\WebRtcBridge.js" LogicalName="AetherBoy.Runtime.Netplay.WebRtcBridge.js" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AetherBoy.RuntimeTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AetherBoy.SmokeTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AetherBoy.DesktopTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
