<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>nanoboy</RootNamespace>
    <AssemblyName>AetherBoy</AssemblyName>
    <Product>AetherBoy</Product>
    <Title>AetherBoy</Title>
    <Description>Experimental Game Boy and Game Boy Color emulator for Windows.</Description>
    <Authors>Frédéric Meyer; AetherBoy contributors</Authors>
    <Company>AetherBoy contributors</Company>
    <Copyright>Copyright © 2014 Frédéric Meyer and contributors</Copyright>
    <Version>4.8.0-alpha.1</Version>
    <AssemblyVersion>4.8.0.0</AssemblyVersion>
    <FileVersion>4.8.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>de</NeutralLanguage>
    <ApplicationIcon>qwdwqdwqdqwdwqdqwdqwdqwd_3fT_icon.ico</ApplicationIcon>
    <Nullable>annotations</Nullable>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Runtime\**\*.cs" />
    <ProjectReference Include="Core\AetherBoy.Core.csproj" />
    <ProjectReference Include="Runtime\AetherBoy.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
