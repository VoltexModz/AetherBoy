<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>nanoboy</RootNamespace>
    <AssemblyName>AetherBoy</AssemblyName>
    <Product>AetherBoy</Product>
    <Title>AetherBoy</Title>
    <Description>Experimental Game Boy, Game Boy Color and Game Boy Advance emulator for Windows.</Description>
    <Authors>Frédéric Meyer; NekoZDevTeam; AetherBoy contributors</Authors>
    <Company>NekoZDevTeam</Company>
    <Copyright>Copyright © 2014 Frédéric Meyer and contributors; © 2026 NekoZDevTeam contributors</Copyright>
    <Version>4.8.0-alpha.1</Version>
    <AssemblyVersion>4.8.0.0</AssemblyVersion>
    <FileVersion>4.8.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>de</NeutralLanguage>
    <ApplicationIcon>Branding\AetherBoy.ico</ApplicationIcon>
    <Nullable>annotations</Nullable>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AetherBoyChannel Condition="'$(AetherBoyChannel)' == ''">development</AetherBoyChannel>
    <AetherBoyBuildId Condition="'$(AetherBoyBuildId)' == ''"></AetherBoyBuildId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AetherBoyChannel" Value="$(AetherBoyChannel)" />
    <AssemblyMetadata Include="AetherBoyBuildId" Value="$(AetherBoyBuildId)" />
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Branding\AetherBoy.ico" LogicalName="AetherBoy.Branding.AppIcon.ico" />
    <EmbeddedResource Include="Branding\AetherBoyMark.png" LogicalName="AetherBoy.Branding.Mark.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Runtime\**\*.cs" />
    <ProjectReference Include="Core\AetherBoy.Core.csproj" />
    <ProjectReference Include="Runtime\AetherBoy.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
